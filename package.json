{
  "name": "repo-viewer",
  "version": "0.7.0",
  "description": "源码仓库浏览器",
  "main": "main.js",
  "scripts": {
    "test": "echo \"Error: no test specified\" && exit 1",
    "start": "electron .",
    "dist": "electron-builder --win --x64 --dir",
    "dist-full": "electron-builder --win --x64",
    "arm": "electron-builder --linux --arm64 --dir"
  },
  "author": "xunxun10",
  "license": "MIT",
  "devDependencies": {
    "electron": "^22.0.0",
    "electron-builder": "^24.4.0",
    "node-gyp": "^9.4.0"
  },
  "dependencies": {
    "axios": "^1.7.2",
    "fast-xml-parser": "^4.4.0",
    "fs-extra": "^11.1.1",
    "ini": "^4.1.1",
    "sqlite3": "^5.1.6",
    "systeminformation": "^5.22.11",
    "winston": "^3.9.0"
  },
  "build": {
    "appId": "com.repo-viewer.xunxun10",
    "directories": {
      "output": "dist"
    },
    "files": [
      "**/*",
      "!**/.vscode/**",
      "!**/.trae/**",
      "!*.sh",
      "!*.md",
      "!*.lock",
      "!dist.files.md5*.txt",
      "!change_log.txt",
      "!.gitignore"
    ],
    "nsis": {
      "shortcutName": "repoviewer",
      "oneClick": false,
      "allowElevation": true,
      "installerIcon": "res/img/repo-viewer.ico",
      "uninstallerIcon": "res/img/repo-viewer.ico",
      "installerHeaderIcon": "res/img/repo-viewer.ico",
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "allowToChangeInstallationDirectory": true
    },
    "win": {
      "target": "nsis",
      "icon": "res/img/repo-viewer.ico"
    },
    "linux": {
      "target": "AppImage",
      "icon": "res/img/repo-viewer.png"
    },
    "extraResources": [
      {
        "from": "res/img",
        "to": "icon",
        "filter": ["repo-viewer.ico", "repo-viewer.png"]
      }
    ]
  },
  "keywords": []
}
